 "frases": [
  {
   "id": "votaron",
   "texto": "¡Ustedes votaron… y Toño tiene que trabajar!",
   "t": 0.0,
   "fin": 2.72
  },
  {
   "id": "dia",
   "texto": "Día uno.",
   "t": 3.19,
   "fin": 4.07
  },
  {
   "id": "cv",
   "texto": "Manda su currículum… que solo dice: nivel cien en Fortnite.",
   "t": 4.23,
   "fin": 7.59
  },
  {
   "id": "rechazo",
   "texto": "Rechazado. Rechazado. Rechazado.",
   "t": 8.05,
   "fin": 10.69
  },
  {
   "id": "mama",
   "texto": "Hasta que su mamá le consigue algo: lavar platos en el restaurante de la esquina.",
   "t": 11.01,
   "fin": 14.57
  },
  {
   "id": "horas",
   "texto": "Ocho horas después…",
   "t": 15.02,
   "fin": 16.26
  },
  {
   "id": "paga",
   "texto": "veinte dólares.",
   "t": 16.663,
   "fin": 17.57
  },
  {
   "id": "leccion",
   "texto": "El primer trabajo no es el soñado… es el que te arranca.",
   "t": 18.05,
   "fin": 20.93
  },
  {
   "id": "primo",
   "texto": "Pero su primo Brayan le manda una foto: ya reservó GTA seis.",
   "t": 21.278,
   "fin": 24.75
  },
  {
   "id": "pregunta",
   "texto": "¿Qué hace Toño con sus veinte dólares?",
   "t": 25.08,
   "fin": 26.76
  },
  {
   "id": "opciones",
   "texto": "Comenta: ahorrar… o invertir.",
   "t": 26.94,
   "fin": 28.94
  },
  {
   "id": "sigueme",
   "texto": "Sígueme para el día dos.",
   "t": 29.36,
   "fin": 30.68
  }
 ],
