{
 "duracion": 54.31,
 "frases": [
  {
   "id": "resumen",
   "texto": "Toño: veinticinco años, treinta dólares… y doce días para juntar mil antes de GTA seis.",
   "t": 0.0,
   "fin": 5.44
  },
  {
   "id": "votaron",
   "texto": "¡Ustedes votaron… y Toño limpia el garaje!",
   "t": 5.73,
   "fin": 8.29
  },
  {
   "id": "dia",
   "texto": "Día tres.",
   "t": 8.54,
   "fin": 9.28
  },
  {
   "id": "polvo",
   "texto": "Tres horas de polvo, arañas… y cajas que no abría desde niño.",
   "t": 9.32,
   "fin": 12.88
  },
  {
   "id": "chaqueta",
   "texto": "En una chaqueta vieja… ¡encuentra diez dólares! Ya tiene cuarenta.",
   "t": 13.107,
   "fin": 16.6
  },
  {
   "id": "publica",
   "texto": "Saca fotos y lo publica todo en internet.",
   "t": 16.89,
   "fin": 19.09
  },
  {
   "id": "bici",
   "texto": "La bici vieja se vende en una hora: treinta y cinco dólares.",
   "t": 19.367,
   "fin": 22.14
  },
  {
   "id": "consola",
   "texto": "Y su consola vieja… se la vende a su primo Brayan por diez.",
   "t": 22.48,
   "fin": 25.4
  },
  {
   "id": "brayan",
   "texto": "Al día siguiente, Brayan la publica… en sesenta.",
   "t": 25.727,
   "fin": 28.26
  },
  {
   "id": "lavadora",
   "texto": "Toño se emociona… y publica la lavadora.",
   "t": 28.587,
   "fin": 31.04
  },
  {
   "id": "mama",
   "texto": "Error. Era de su mamá.",
   "t": 31.243,
   "fin": 32.43
  },
  {
   "id": "total",
   "texto": "Al final del día: ochenta y cinco dólares. Su mejor día hasta ahora.",
   "t": 32.87,
   "fin": 36.39
  },
  {
   "id": "leccion",
   "texto": "Lección del día: lo que no usas vale dinero… pero averigua el precio antes de vender.",
   "t": 36.793,
   "fin": 40.9
  },
  {
   "id": "pregunta",
   "texto": "Brayan ganó cincuenta sin trabajar… y Toño quiere aprender a hacer lo mismo.",
   "t": 41.227,
   "fin": 44.72
  },
  {
   "id": "opciones",
   "texto": "Comenta: gastar todo su dinero en el curso de un gurú que promete hacerlo millonario antes de GTA seis… o aprender gratis en YouTube.",
   "t": 44.96,
   "fin": 51.48
  },
  {
   "id": "sigueme",
   "texto": "Sígueme para el día cuatro.",
   "t": 51.87,
   "fin": 53.11
  }
 ],
