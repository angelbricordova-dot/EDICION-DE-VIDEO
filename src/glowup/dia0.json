  {
   "id": "este",
   "texto": "Este es Toño.",
   "t": 0.0,
   "fin": 0.84
  },
  {
   "id": "edad",
   "texto": "Veinticinco años. Cero pesos.",
   "t": 1.43,
   "fin": 3.43
  },
  {
   "id": "mama",
   "texto": "Vive de lo que le da su mamá.",
   "t": 3.862,
   "fin": 5.11
  },
  {
   "id": "gta",
   "texto": "Pero GTA seis sale en quince días…",
   "t": 5.708,
   "fin": 7.74
  },
  {
   "id": "juego",
   "texto": "y no tiene ni para el juego.",
   "t": 8.23,
   "fin": 9.63
  },
  {
   "id": "meta",
   "texto": "Tiene quince días para juntar mil dólares.",
   "t": 10.307,
   "fin": 12.36
  },
  {
   "id": "pregunta",
   "texto": "¿Qué hace primero?",
   "t": 12.9,
   "fin": 13.74
  },
  {
   "id": "opciones",
   "texto": "Comenta: vender sus cosas… o buscar trabajo.",
   "t": 14.08,
   "fin": 16.84
  },
  {
   "id": "sigueme",
   "texto": "Sígueme para el día uno.",
   "t": 17.43,
   "fin": 18.67
  }
 ],
