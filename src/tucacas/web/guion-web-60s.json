 "frases": [
  {
   "desde": 0.147,
   "hasta": 4.56,
   "texto": "¿Vienes a Tucacas? Ahora reservar con nosotros es mucho más fácil.",
   "clave": "mucho más fácil"
  },
  {
   "desde": 4.8,
   "hasta": 7.52,
   "texto": "Entra a nuestro perfil y toca el enlace.",
   "clave": "el enlace"
  },
  {
   "desde": 7.696,
   "hasta": 11.28,
   "texto": "Esta es nuestra página nueva: Tu Día en Tucacas.",
   "clave": "página nueva"
  },
  {
   "desde": 11.493,
   "hasta": 17.28,
   "texto": "Eliges tus fechas, cuántas personas vienen, y ves al momento qué está libre.",
   "clave": "qué está libre"
  },
  {
   "desde": 17.48,
   "hasta": 24.0,
   "texto": "Conoces el apartamento treinta por dentro: las fotos, lo que incluye y dónde queda.",
   "clave": "por dentro"
  },
  {
   "desde": 24.44,
   "hasta": 30.0,
   "texto": "Aire en todos los ambientes, WiFi de fibra y tanque de agua propio.",
   "clave": "tanque de agua propio"
  },
  {
   "desde": 30.4,
   "hasta": 34.56,
   "texto": "A cinco minutos de los muelles, y con piscina para los chamos.",
   "clave": "cinco minutos"
  },
  {
   "desde": 34.92,
   "hasta": 41.8,
   "texto": "¿Te gustó? Tocas «Reservar por WhatsApp» y el mensaje sale listo con tus fechas.",
   "clave": "WhatsApp"
  },
  {
   "desde": 41.92,
   "hasta": 48.56,
   "texto": "En la página no se cobra nada: todo lo confirmas con nosotros, rápido y en confianza.",
   "clave": "no se cobra nada"
  },
  {
   "desde": 48.96,
   "hasta": 52.48,
   "texto": "Y cuando cae la noche, la churuata te espera.",
   "clave": "la churuata"
  },
  {
   "desde": 52.747,
   "hasta": 55.6,
   "texto": "Tu Día en Tucacas… empieza aquí.",
   "clave": "empieza aquí"
  }
 ],
