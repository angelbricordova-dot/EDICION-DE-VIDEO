  "frases": [
    {
      "desde": 0.4,
      "hasta": 3.9,
      "texto": "Hay días que se recuerdan toda la vida…",
      "clave": "toda la vida"
    },
    {
      "desde": 4.2,
      "hasta": 7.6,
      "texto": "…y empiezan en Tucacas.",
      "clave": "Tucacas"
    },
    {
      "desde": 8.2,
      "hasta": 12.9,
      "texto": "Llegas, te recibimos, y nosotros nos encargamos de tu autorización de ingreso al conjunto.",
      "clave": "autorización de ingreso"
    },
    {
      "desde": 13.2,
      "hasta": 18.8,
      "texto": "El apartamento treinta es comodidad real para siete personas, sin romper el presupuesto.",
      "clave": "comodidad real"
    },
    {
      "desde": 19.2,
      "hasta": 24.8,
      "texto": "Dos habitaciones, cinco camas, y aire acondicionado en todos los ambientes, para dormir sabroso después de la playa.",
      "clave": "dormir sabroso"
    },
    {
      "desde": 25.2,
      "hasta": 29.6,
      "texto": "Cocina equipada, dos baños…",
      "clave": "Cocina equipada"
    },
    {
      "desde": 30.1,
      "hasta": 34.8,
      "texto": "…tanque de agua propio para que no te falte, y WiFi de fibra óptica.",
      "clave": "tanque de agua propio"
    },
    {
      "desde": 35.2,
      "hasta": 41.8,
      "texto": "Bajas a la piscina con los chamos, o en cinco minutos estás en el muelle, rumbo a Cayo Sombrero.",
      "clave": "Cayo Sombrero"
    },
    {
      "desde": 42.3,
      "hasta": 46.6,
      "texto": "Y cuando cae la noche, la churuata te espera.",
      "clave": "la churuata"
    },
    {
      "desde": 47.2,
      "hasta": 53.6,
      "texto": "Mira las fechas libres en nuestra página y reserva directo por WhatsApp. Rápido y en confianza.",
      "clave": "WhatsApp"
    },
    {
      "desde": 54.4,
      "hasta": 59.4,
      "texto": "Tu Día en Tucacas… empieza aquí.",
      "clave": "empieza aquí"
    }
