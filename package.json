{
  "name": "edicion-de-video",
  "version": "1.0.0",
  "private": true,
  "description": "Proyecto de edición de video con Remotion",
  "scripts": {
    "dev": "remotion studio",
    "build": "remotion bundle",
    "render": "remotion render Cambio out/cambio.mp4",
    "upgrade": "remotion upgrade",
    "lint": "tsc",
    "render:hello": "remotion render HelloWorld out/video.mp4",
    "render:prueba": "remotion render Prueba out/prueba.mp4",
    "draft": "remotion render Prueba out/draft.mp4 --scale=0.5 --crf=28",
    "sheet": "node scripts/sheet.mjs --timeline src/prueba/timeline.json",
    "wave": "node scripts/wave.mjs --timeline src/prueba/timeline.json public/audio/prueba.mp3"
  },
  "license": "UNLICENSED",
  "dependencies": {
    "@remotion/cli": "4.0.534",
    "@remotion/fonts": "4.0.534",
    "@remotion/layout-utils": "4.0.534",
    "@remotion/media": "4.0.534",
    "@remotion/noise": "4.0.534",
    "@remotion/paths": "4.0.534",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "remotion": "4.0.534"
  },
  "devDependencies": {
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "typescript": "7.0.2"
  }
}
